<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the name under the icon, and in the share sheet's row of apps -->
	<key>CFBundleDisplayName</key>
	<string>Mogul Clip</string>
	<!-- the only encryption is https, which ios does: answers app store connect's export compliance question -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- plain http to a gateway running on this machine (http://127.0.0.1:1010); production is https -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>