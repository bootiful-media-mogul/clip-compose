<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the app and its share extension keep the login here, so one login does for both -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.joshlong.mogul.clip</string>
	</array>
</dict>
</plist>
